{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>cmeister2/renovate"],
  "packageRules": [
    {
      "description": "Work around npm/cli#9800 when regenerating lockfiles with bundled dependencies",
      "matchManagers": ["npm"],
      "skipInstalls": false
    },
    {
      "description": "cadmpeg 0.6.3-0.6.7 regress qualified Fusion or Inventor geometry; retain 0.6.2 until a fixed release",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["/^cadmpeg-/"],
      "allowedVersions": "!/^0\\.6\\.[3-7]$/"
    },
    {
      "matchManagers": ["cargo"],
      "matchIsBreaking": true,
      "groupName": "Cargo breaking dependency updates",
      "groupSlug": "cargo-breaking-dependencies",
      "automerge": false
    }
  ]
}
